<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:ProjectFlow.Helpers"
    >
    <helpers:EnumDisplayConverter x:Key="EnumDisplayConverter"/>
    
    <!-- Заголовок редактора -->
    <Style x:Key="EditorTitleStyle"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Подписи полей -->
    <Style x:Key="EditorLabelStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Разделитель -->
    <Style x:Key="EditorSeparatorStyle"
           TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background"
                Value="{StaticResource BorderBrush}"/>
        <Setter Property="Margin" Value="0,16"/>
    </Style>

    <!-- Оформление DatePicker -->
    <Style x:Key="ModernDatePickerStyle"
           TargetType="DatePicker">
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background"
                Value="{StaticResource SurfaceBrush}"/>
    </Style>

</ResourceDictionary>
