<Window x:Class="ProjectFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProjectFlow.ViewModels"
        xmlns:views="clr-namespace:ProjectFlow.Views"
        xmlns:helpers="clr-namespace:ProjectFlow.Helpers"
        Title="ProjectFlow — Управление проектами"
        Width="1280"
        Height="800"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <helpers:SelectedPageConverter
            x:Key="SelectedPageConverter"/>

        <!-- Представления -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
            <views:ProjectsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
            <views:EmployeesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TasksViewModel}">
            <views:TasksView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView/>
        </DataTemplate>

        <!-- Стиль навигации -->
        <Style x:Key="NavToggleStyle"
               TargetType="ToggleButton">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">

                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#1E293B"/>
                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDatabaseReady}"
                 Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}">

            <DockPanel Margin="14,24">

                <StackPanel DockPanel.Dock="Top">

                    <!-- Логотип -->
                    <StackPanel Orientation="Horizontal"
                                Margin="12,8,0,35">

                        <Border Width="42"
                                Height="42"
                                CornerRadius="10"
                                Background="{StaticResource PrimaryBrush}">

                            <TextBlock Text="PF"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="ProjectFlow"
                                   Foreground="White"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>

                    </StackPanel>

                    <!-- Главная -->
                    <ToggleButton Content="⌂   Главная"
                        Style="{StaticResource NavToggleStyle}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Главная"
                        IsChecked="{Binding SelectedPage,
                            Converter={StaticResource SelectedPageConverter},
                            ConverterParameter=Главная,
                            Mode=OneWay}"/>

                    <!-- Проекты -->
                    <ToggleButton Content="▣   Проекты"
                        Style="{StaticResource NavToggleStyle}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Проекты"
                        IsChecked="{Binding SelectedPage,
                            Converter={StaticResource SelectedPageConverter},
                            ConverterParameter=Проекты,
                            Mode=OneWay}"/>

                    <!-- Задачи -->
                    <ToggleButton Content="☑   Задачи"
                        Style="{StaticResource NavToggleStyle}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Задачи"
                        IsChecked="{Binding SelectedPage,
                            Converter={StaticResource SelectedPageConverter},
                            ConverterParameter=Задачи,
                            Mode=OneWay}"/>

                    <!-- Сотрудники -->
                    <ToggleButton Content="♙   Сотрудники"
                        Style="{StaticResource NavToggleStyle}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Сотрудники"
                        IsChecked="{Binding SelectedPage,
                            Converter={StaticResource SelectedPageConverter},
                            ConverterParameter=Сотрудники,
                            Mode=OneWay}"/>

                    <!-- Статистика -->
                    <ToggleButton Content="▥   Статистика"
                        Style="{StaticResource NavToggleStyle}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Статистика"
                        IsChecked="{Binding SelectedPage,
                            Converter={StaticResource SelectedPageConverter},
                            ConverterParameter=Статистика,
                            Mode=OneWay}"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">

                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="ProjectFlow"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="  ›  "
                                   Foreground="#94A3B8"
                                   FontSize="18"/>

                        <TextBlock Text="{Binding SelectedPage}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"/>

                    </StackPanel>


                    <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                        <TextBlock
        Text="{Binding DatabaseStatus}"
        Foreground="{StaticResource TextSecondaryBrush}"
        FontSize="12"
        VerticalAlignment="Center"
        Margin="0,0,12,0"/>


                        <Button Content="Повторить подключение"
        Click="RetryConnection_Click">

                            <Button.Style>
                                <Style TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">

                                    <Style.Triggers>

                                        <!-- Подключение уже выполняется -->
                                        <DataTrigger Binding="{Binding IsConnecting}"
                             Value="True">
                                            <Setter Property="IsEnabled"
                            Value="False"/>
                                        </DataTrigger>

                                        <!-- MongoDB уже подключена -->
                                        <DataTrigger Binding="{Binding IsDatabaseReady}"
                             Value="True">
                                            <Setter Property="IsEnabled"
                            Value="False"/>
                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>


                    </StackPanel>


                </Grid>
            </Border>

            <!-- Контент -->
            <Grid Grid.Row="1" Margin="30,28,30,30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding PageTitle}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,25"/>

                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentPage}"/>

            </Grid>
        </Grid>
    </Grid>
</Window>
