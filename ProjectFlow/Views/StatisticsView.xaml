<UserControl x:Class="ProjectFlow.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="0,0,8,8">

            <!-- Общая статистика -->
            <UniformGrid Columns="3" Margin="0,0,0,20">

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Всего задач"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Text="{Binding TotalTasks}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Просроченные"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Text="{Binding OverdueTasks}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Высокий приоритет"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding HighPriorityTasks}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#D97706"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Выполнение задач -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Общий прогресс выполнения"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <TextBlock
                        Text="{Binding OverallProgress, StringFormat={}{0:F1}%}"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryBrush}"/>

                    <ProgressBar
                        Value="{Binding OverallProgress, Mode=OneWay}"
                        Maximum="100"
                        Height="12"
                        Foreground="{StaticResource PrimaryBrush}"
                        Background="#E2E8F0"
                        Margin="0,12,0,0"/>

                </StackPanel>
            </Border>

            <!-- Распределение по статусам -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Распределение задач по статусам"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="К выполнению"
                               Margin="0,0,0,6"/>

                    <ProgressBar Value="{Binding PlannedTasks, Mode=OneWay}"
                                 Maximum="{Binding TotalTasks, Mode=OneWay}"
                                 Height="14"
                                 Foreground="#94A3B8"
                                 Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding PlannedTasks, StringFormat=Задач: {0}}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="В работе"
                               Margin="0,0,0,6"/>

                    <ProgressBar Value="{Binding ActiveTasks, Mode=OneWay}"
                                 Maximum="{Binding TotalTasks, Mode=OneWay}"
                                 Height="14"
                                 Foreground="#4F46E5"
                                 Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding ActiveTasks, StringFormat=Задач: {0}}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="Выполнено"
                               Margin="0,0,0,6"/>

                    <ProgressBar Value="{Binding CompletedTasks, Mode=OneWay}"
                                 Maximum="{Binding TotalTasks, Mode=OneWay}"
                                 Height="14"
                                 Foreground="{StaticResource SuccessBrush}"
                                 Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding CompletedTasks, StringFormat=Задач: {0}}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                </StackPanel>
            </Border>

            <!-- Статистика проектов -->
            <Border Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock Text="Статистика по проектам"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>

                    <DataGrid ItemsSource="{Binding ProjectStatistics}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Height="280"
                              RowHeight="42"
                              ColumnHeaderHeight="40"
                              Style="{StaticResource ModernDataGridStyle}"
                              >

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Проект"
                                Binding="{Binding ProjectName}"
                                Width="2*"/>

                            <DataGridTextColumn
                                Header="Всего"
                                Binding="{Binding TotalTasks}"
                                Width="65"/>

                            <DataGridTextColumn
                                Header="В работе"
                                Binding="{Binding ActiveTasks}"
                                Width="85"/>

                            <DataGridTextColumn
                                Header="Готово"
                                Binding="{Binding CompletedTasks}"
                                Width="75"/>

                            <DataGridTextColumn
                                Header="Просрочено"
                                Binding="{Binding OverdueTasks}"
                                Width="105"/>

                            <DataGridTemplateColumn
                                Header="Прогресс"
                                Width="125">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center"
                                                    Margin="5">

                                            <TextBlock
                                                Text="{Binding ProgressPercentage,
                                                       StringFormat={}{0:F1}%}"
                                                HorizontalAlignment="Right"
                                                FontSize="12"/>

                                            <ProgressBar
                                                Value="{Binding ProgressPercentage,
                                                        Mode=OneWay}"
                                                Maximum="100"
                                                Height="6"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                Margin="0,5,0,0"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

            <!-- Обновление -->
            <DockPanel Margin="0,16,0,0">

                <Button Content="Обновить статистику"
                        Command="{Binding LoadStatisticsCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        DockPanel.Dock="Right"/>

                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

            </DockPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
