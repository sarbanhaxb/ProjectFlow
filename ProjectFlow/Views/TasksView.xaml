<UserControl x:Class="ProjectFlow.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}">

        <DockPanel LastChildFill="True">

            <!-- Панель действий -->
            <WrapPanel DockPanel.Dock="Top"
                       Margin="0,0,0,18">

                <Button Content="+ Создать задачу"
                        Command="{Binding CreateTaskCommand}"
                        Style="{StaticResource BusyAwarePrimaryButtonStyle}"
                        Margin="0,0,10,8"/>

                <Button Content="Редактировать"
                        Command="{Binding EditTaskCommand}"
                        Style="{StaticResource BusyAwareSecondaryButtonStyle}"
                        Margin="0,0,10,8"/>

                <Button Content="Удалить"
                        Command="{Binding DeleteTaskCommand}"
                        Style="{StaticResource BusyAwareSecondaryButtonStyle}"
                        Margin="0,0,10,8"/>

                <Button Content="Обновить"
                        Command="{Binding LoadTasksCommand}"
                        Style="{StaticResource BusyAwareSecondaryButtonStyle}"
                        Margin="0,0,0,8"/>

            </WrapPanel>

            <!-- Фильтр по проекту -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,18">

                <TextBlock Text="Проект:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <ComboBox ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProjectFilter}"
                          DisplayMemberPath="Name"
                          Width="240"
                          Margin="0,0,10,0">

                    <ComboBox.Style>
                        <Style TargetType="ComboBox"
           BasedOn="{StaticResource ModernComboBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}"
                         Value="True">
                                    <Setter Property="IsEnabled"
                        Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>

                </ComboBox>

                <Button Content="Применить"
                        Command="{Binding ApplyFilterCommand}"
                        Style="{StaticResource BusyAwareSecondaryButtonStyle}"
                        Margin="0,0,10,0"/>

                <Button Content="Сбросить"
                        Command="{Binding ResetFilterCommand}"
                        Style="{StaticResource BusyAwareSecondaryButtonStyle}"/>

            </StackPanel>

            <!-- Строка состояния -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13"
                       Margin="0,16,0,0"/>

            <!-- Таблица задач -->
            <DataGrid ItemsSource="{Binding Tasks}"
                      SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="42"
                      ColumnHeaderHeight="40"
                      Style="{StaticResource ModernDataGridStyle}"
                      >

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Задача"
                        Binding="{Binding Title}"
                        Width="2*"/>

                    <DataGridTextColumn
                        Header="Проект"
                        Binding="{Binding ProjectName}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Исполнитель"
                        Binding="{Binding AssigneeName}"
                        Width="*"/>


                    <DataGridTemplateColumn Header="Статус"
                        Width="145">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Border Style="{StaticResource StatusBadgeStyle}">

                                    <TextBlock Text="{Binding Status}"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                                </Border>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <DataGridTextColumn
                        Header="Приоритет"
                        Binding="{Binding Priority}"
                        Width="110"/>

                    <DataGridTextColumn
                        Header="Срок"
                        Binding="{Binding DueDate,
                                  StringFormat=dd.MM.yyyy,
                                  TargetNullValue=—}"
                        Width="115"/>

                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>
    </Border>
</UserControl>
