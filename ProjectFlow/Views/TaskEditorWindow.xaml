<Window x:Class="ProjectFlow.Views.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача"
        Width="580"
        Height="760"
        MinWidth="540"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Данные задачи"
           Style="{StaticResource EditorTitleStyle}"
           Margin="0,0,0,22"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Название задачи" Style="{StaticResource EditorLabelStyle}"/>
                <TextBox x:Name="TitleTextBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,6,0,16"/>

                <TextBlock Text="Описание" Style="{StaticResource EditorLabelStyle}"/>
                <TextBox x:Name="DescriptionTextBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Height="85"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         Margin="0,6,0,16"/>

                <TextBlock Text="Проект" Style="{StaticResource EditorLabelStyle}"/>
                <ComboBox x:Name="ProjectComboBox"
                          Style="{StaticResource ModernComboBoxStyle}"
                          DisplayMemberPath="Name"
                          SelectionChanged="ProjectComboBox_SelectionChanged"
                          Margin="0,6,0,16"/>

                <TextBlock Text="Исполнитель" Style="{StaticResource EditorLabelStyle}"/>
                <ComboBox x:Name="AssigneeComboBox"
                          Style="{StaticResource ModernComboBoxStyle}"
                          DisplayMemberPath="FullName"
                          Margin="0,6,0,16"/>

                <TextBlock Text="Статус" Style="{StaticResource EditorLabelStyle}"/>

                <ComboBox x:Name="StatusComboBox"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Margin="0,6,0,16">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>


                <TextBlock Text="Приоритет" Style="{StaticResource EditorLabelStyle}"/>

                <ComboBox x:Name="PriorityComboBox"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Margin="0,6,0,16">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>


                <TextBlock Text="Срок выполнения" Style="{StaticResource EditorLabelStyle}"/>
                <DatePicker x:Name="DueDatePicker"
                            Style="{StaticResource ModernDatePickerStyle}"
                            Margin="0,6,0,8"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Отмена"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="110"
                    Margin="0,0,12,0"
                    IsCancel="True"/>

            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="125"
                    Click="SaveButton_Click"
                    IsEnabled="False"/>

        </StackPanel>
    </Grid>
</Window>
