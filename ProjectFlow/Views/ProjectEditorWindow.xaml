<Window x:Class="ProjectFlow.Views.ProjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проект"
        Width="570"
        Height="720"
        MinWidth="530"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">

        <Border Style="{StaticResource CardStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Данные проекта"
                               Style="{StaticResource EditorTitleStyle}"/>

                    <TextBlock Text="Основная информация и участники"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,0,0,20"/>
                </StackPanel>

                <!-- Форма -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="0,0,6,0">

                        <TextBlock Text="Название проекта"
                                   Style="{StaticResource EditorLabelStyle}"/>

                        <TextBox x:Name="NameTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="Описание"
                                   Style="{StaticResource EditorLabelStyle}"/>

                        <TextBox x:Name="DescriptionTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="75"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="Статус"
                                   Style="{StaticResource EditorLabelStyle}"/>


                        <ComboBox x:Name="StatusComboBox"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Margin="0,0,0,16">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>


                        <TextBlock Text="Дата начала"
                                   Style="{StaticResource EditorLabelStyle}"/>

                        <DatePicker x:Name="StartDatePicker"
                                    Style="{StaticResource ModernDatePickerStyle}"
                                    Margin="0,0,0,16"/>

                        <TextBlock Text="Дата окончания"
                                   Style="{StaticResource EditorLabelStyle}"/>

                        <DatePicker x:Name="EndDatePicker"
                                    Style="{StaticResource ModernDatePickerStyle}"
                                    Margin="0,0,0,16"/>

                        <TextBlock Text="Участники проекта"
                                   Style="{StaticResource EditorLabelStyle}"/>

                        <TextBlock Text="Нажимайте на сотрудников, чтобы выбрать или отменить выбор"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>

                        <ListBox x:Name="MembersListBox"
                                 Height="130"
                                 SelectionMode="Multiple"
                                 DisplayMemberPath="FullName"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button Content="Отмена"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="110"
                            Margin="0,0,10,0"
                            IsCancel="True"/>


                    <Button x:Name="SaveButton"
        Content="Сохранить"
        Style="{StaticResource PrimaryButtonStyle}"
        Width="120"
        IsEnabled="False"
        Click="SaveButton_Click"/>


                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
