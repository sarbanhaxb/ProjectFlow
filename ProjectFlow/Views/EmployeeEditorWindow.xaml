<Window x:Class="ProjectFlow.Views.EmployeeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник"
        Width="510"
        Height="500"
        MinWidth="510"
        MinHeight="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Border Style="{StaticResource CardStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Данные сотрудника"
                               Style="{StaticResource EditorTitleStyle}"/>

                    <TextBlock Text="Заполните информацию о сотруднике"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,0,0,20"/>
                </StackPanel>

                <!-- Поля -->
                <StackPanel Grid.Row="1">

                    <TextBlock Text="ФИО сотрудника"
                               Style="{StaticResource EditorLabelStyle}"/>

                    <TextBox x:Name="FullNameTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Электронная почта"
                               Style="{StaticResource EditorLabelStyle}"/>

                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Должность"
                               Style="{StaticResource EditorLabelStyle}"/>

                    <TextBox x:Name="PositionTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"/>

                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button Content="Отмена"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="110"
                            Margin="0,0,10,0"
                            IsCancel="True"/>

                    <Button Content="Сохранить"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="120"
                            Click="SaveButton_Click"/>

                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
