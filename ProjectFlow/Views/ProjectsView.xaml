<UserControl x:Class="ProjectFlow.Views.ProjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="White"
            CornerRadius="12"
            Padding="25"
            Style="{StaticResource CardStyle}">

        <DockPanel>

            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,20">

                <Button Content="Обновить"
                        Command="{Binding LoadProjectsCommand}"
                        Style="{StaticResource BusyAwareSecondaryButtonStyle}"
                        Width="110"
                        Height="40"
                        Margin="0,0,10,0"/>

                <Button Content="+ Создать"
                        Command="{Binding CreateProjectCommand}"
                        Style="{StaticResource BusyAwarePrimaryButtonStyle}"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"/>

                <Button Content="Редактировать"
                        Command="{Binding EditProjectCommand}"
                        Style="{StaticResource BusyAwareSecondaryButtonStyle}"
                        Width="140"
                        Height="40"
                        Margin="0,0,10,0"/>

                <Button Content="Удалить"
                        Command="{Binding DeleteProjectCommand}"
                        Style="{StaticResource BusyAwareSecondaryButtonStyle}"
                        Width="110"
                        Height="40"/>

            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       FontSize="13"
                       Foreground="#64748B"
                       Margin="0,15,0,0"/>

            <DataGrid ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Название"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Описание"
                                        Binding="{Binding Description}"
                                        Width="2*"/>


                    <DataGridTemplateColumn Header="Статус"
                        Width="145">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Border Style="{StaticResource StatusBadgeStyle}">

                                    <TextBlock Text="{Binding Status}"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                                </Border>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <DataGridTextColumn Header="Начало"
                                        Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Окончание"
                                        Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Участники"
                    Binding="{Binding Members}"
                    Width="2*"/>

                </DataGrid.Columns>

            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
