<UserControl x:Class="ProjectFlow.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Карточки статистики -->
        <UniformGrid Grid.Row="0"
                     Columns="4"
                     Margin="0,0,0,24">

            <!-- Проекты -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Проекты"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"/>

                    <TextBlock Text="{Binding TotalProjects}"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Активные задачи -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="8,0">
                <StackPanel>
                    <TextBlock Text="Активные задачи"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Text="{Binding ActiveTasks}"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="0,8,0,0"
                               Foreground="#2563EB"/>
                </StackPanel>
            </Border>

            <!-- Выполненные задачи -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="8,0">
                <StackPanel>
                    <TextBlock Text="Выполненные"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Text="{Binding CompletedTasks}"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Border>

            <!-- Просроченные задачи -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Просроченные"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Text="{Binding OverdueTasks}"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Таблица проектов -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0">

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Последние проекты"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <DataGrid ItemsSource="{Binding RecentProjects}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeight="44"
                              Style="{StaticResource ModernDataGridStyle}"
                              >

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="Проект"
                                Binding="{Binding Name}"
                                Width="2*"/>


                            <DataGridTemplateColumn Header="Статус"
                        Width="145">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Border Style="{StaticResource StatusBadgeStyle}">

                                            <TextBlock Text="{Binding Status}"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                                        </Border>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <DataGridTextColumn
                                Header="Участники"
                                Binding="{Binding Members}"
                                Width="2*"/>

                            <DataGridTemplateColumn Header="Прогресс"
                        Width="125">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <StackPanel VerticalAlignment="Center"
                        Margin="6,0">

                                            <TextBlock
                    Text="{Binding ProgressPercentage,
                           StringFormat={}{0:F1}%}"
                    FontSize="12"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,5"/>

                                            <ProgressBar
                        Value="{Binding ProgressPercentage, Mode=OneWay}"
                        Minimum="0"
                        Maximum="100"
                        Height="6"
                        Foreground="{StaticResource PrimaryBrush}"
                        Background="#E2E8F0"/>

                                        </StackPanel>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
        Style="{StaticResource CardStyle}"
        Margin="10,0,0,0">

                <StackPanel>

                    <TextBlock Text="Выполнение задач"
                   FontSize="21"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,8"/>

                    <TextBlock Text="Распределение по статусам"
                   FontSize="13"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,24"/>

                    <!-- К выполнению -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="К выполнению"
                       FontSize="13"/>

                        <TextBlock Grid.Column="1"
                       Text="{Binding PlannedTasks}"
                       FontWeight="SemiBold"/>
                    </Grid>

                    <ProgressBar
            Value="{Binding PlannedPercentage, Mode=OneWay}"
            Maximum="100"
            Height="11"
            Foreground="#94A3B8"
            Background="#E2E8F0"
            Margin="0,0,0,25"/>

                    <!-- В работе -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="В работе"
                       FontSize="13"/>

                        <TextBlock Grid.Column="1"
                       Text="{Binding ActiveTasks}"
                       FontWeight="SemiBold"/>
                    </Grid>

                    <ProgressBar
            Value="{Binding ActivePercentage, Mode=OneWay}"
            Maximum="100"
            Height="11"
            Foreground="{StaticResource PrimaryBrush}"
            Background="#E2E8F0"
            Margin="0,0,0,25"/>

                    <!-- Выполнено -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Выполнено"
                       FontSize="13"/>

                        <TextBlock Grid.Column="1"
                       Text="{Binding CompletedTasks}"
                       FontWeight="SemiBold"/>
                    </Grid>

                    <ProgressBar
            Value="{Binding CompletedPercentage, Mode=OneWay}"
            Maximum="100"
            Height="11"
            Foreground="{StaticResource SuccessBrush}"
            Background="#E2E8F0"
            Margin="0,0,0,25"/>

                    <!-- Итого -->
                    <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,18,0,0"
                Margin="0,5,0,0">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Всего задач"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Column="1"
                           Text="{Binding TotalTasks}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>

                    </Border>

                </StackPanel>
            </Border>

        </Grid>

        <!-- Нижняя панель -->
        <DockPanel Grid.Row="2"
                   Margin="0,16,0,0">

            <Button DockPanel.Dock="Right"
                    Content="Обновить данные"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadDashboardCommand}"
                    HorizontalAlignment="Right"/>

            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"/>
        </DockPanel>
    </Grid>
</UserControl>
