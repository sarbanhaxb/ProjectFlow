<UserControl x:Class="ProjectFlow.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="White"
            CornerRadius="12"
            Padding="25">

        <StackPanel>
            <TextBlock Text="Обзор проектов"
                       FontSize="22"
                       FontWeight="SemiBold"/>

            <TextBlock
                Text="Здесь будет отображаться статистика проектов и задач."
                FontSize="15"
                Foreground="#64748B"
                Margin="0,15,0,0"/>
        </StackPanel>

    </Border>
</UserControl>